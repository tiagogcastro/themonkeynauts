# API (porta 3333)

Copie para `.env` — todos os valores funcionam localmente sem credenciais externas.

# server
PORT=3333
NODE_ENV=development

# auth
APP_SECRET=change-me-in-production
APP_WEB_URL=http://localhost:5173

# database (docker-compose.yml na raiz)
DATABASE_URL=postgresql://the-monkeynauts:the-monkeynauts@localhost:5432/the-monkeynauts

# blockchain
BLOCKCHAIN_DRIVER=sandbox
BSC_RPC_URL=https://bsc-dataseed.binance.org
SMART_CONTRACT=0xc8031A63a8cE10574Aab7999a99cdC454B916AB9
SALES_WALLET=0x6c4543b80c4A2Bb922e31E045a67217F13caf797
SALES_PRIVATE_KEY=
WALLET_PRIVATE_KEY=
TX_WAIT_ATTEMPTS=15
TX_WAIT_DELAY_MS=2000

MAIL_DRIVER=ethereal

ADMIN_NICKNAME=admin
ADMIN_EMAIL=admin@themonkeynauts.local
ADMIN_PASS=Admin@1234
