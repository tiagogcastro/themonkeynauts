# server
PORT=3333
NODE_ENV=development

# auth
APP_SECRET=change-me-in-production
APP_WEB_URL=http://localhost:5173

# database (docker-compose.yml at repo root)
DATABASE_URL=postgresql://the-monkeynauts:the-monkeynauts@localhost:5432/the-monkeynauts

# blockchain
# sandbox = fictitious currency, no chain calls (local/demo, no keys needed)
# rpc     = real BSC integration through ethers
BLOCKCHAIN_DRIVER=sandbox

BSC_RPC_URL=https://bsc-dataseed.binance.org

# official SPC token contract on BSC mainnet (validated: symbol SPC, 18 decimals)
SMART_CONTRACT=0xc8031A63a8cE10574Aab7999a99cdC454B916AB9

# wallet that receives sales/deposits
SALES_WALLET=0x6c4543b80c4A2Bb922e31E045a67217F13caf797

# only needed for real on-chain payouts (rpc driver):
SALES_PRIVATE_KEY=
WALLET_PRIVATE_KEY=

# how long to wait for a transaction to show up on-chain (rpc driver)
TX_WAIT_ATTEMPTS=15
TX_WAIT_DELAY_MS=2000

# mail (ethereal works out of the box - preview URL is printed in the console)
MAIL_DRIVER=ethereal

# seed admin account
ADMIN_NICKNAME=admin
ADMIN_EMAIL=admin@themonkeynauts.local
ADMIN_PASS=Admin@1234
