{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "The Monkeynauts API",
  "main": "src/shared/infra/http/server.ts",
  "prisma": {
    "seed": "tsx src/shared/infra/database/prisma/seeders/index.ts"
  },
  "scripts": {
    "dev:server": "tsx watch --clear-screen=false src/shared/infra/http/server.ts",
    "build": "tsup src/shared/infra/http/server.ts --format cjs --target node24 --outDir build --sourcemap",
    "start": "node build/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "cron": "^4.4.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "handlebars": "^4.7.9",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^7.0.11",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^6.19.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  }
}
